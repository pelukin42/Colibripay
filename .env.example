# ---------------------------------------------------------------------------
# ColibriPay — copiá este archivo a .env y completá los valores.
# .env está en .gitignore. Nunca lo commitees: contiene llaves que firman
# cobros reales.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Base de datos ---
DATABASE_URL="postgresql://colibri:colibri@localhost:5432/colibripay?schema=public"

# --- Colas y caché (BullMQ para webhooks, reintentos y liberación de fondos) ---
REDIS_URL="redis://localhost:6379"

# --- URLs de las apps ---
API_URL="http://localhost:4000"
CHECKOUT_URL="http://localhost:4001"
DASHBOARD_URL="http://localhost:3000"

# --- Secretos ---
# Firma de sesiones del dashboard. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiame-en-produccion"

# Cifrado en reposo de IBANs, secretos de webhook y credenciales de adquirente.
# DEBE ser 32 bytes en base64. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotarla invalida todo lo cifrado: planificá la rotación antes de producción.
ENCRYPTION_KEY="ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbi0hIQ=="

# --- Adquirente ---
# "sandbox" mientras no haya contrato bancario. Al certificar con un banco,
# se agrega su adaptador y se cambia este valor.
DEFAULT_ACQUIRER="sandbox"
