{
  "name": "@colibripay/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "verify-ledger": "dotenv -e ../../.env -- tsx scripts/verify-ledger.ts",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf node_modules .turbo",
    "postgres": "tsx scripts/dev-postgres.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
