{
  "name": "colibripay",
  "version": "0.1.0",
  "private": true,
  "description": "Pasarela de pagos para Costa Rica — core, checkout hospedado y dashboard de comercios",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @colibripay/db generate",
    "db:migrate": "pnpm --filter @colibripay/db migrate",
    "db:push": "pnpm --filter @colibripay/db push",
    "db:seed": "pnpm --filter @colibripay/db seed",
    "db:studio": "pnpm --filter @colibripay/db studio",
    "clean": "turbo run clean && rimraf node_modules",
    "db:local": "pnpm --filter @colibripay/db postgres",
    "db:verify-ledger": "pnpm --filter @colibripay/db verify-ledger",
    "webhook:receiver": "tsx scripts/webhook-receiver.ts",
    "vault": "tsx scripts/sandbox-vault.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "@colibripay/shared": "workspace:*",
    "@colibripay/acquirers": "workspace:*"
  }
}
